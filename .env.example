# Copy to .env for local dev, or set these as Railway service variables.
# See REMINDER_ENGINE.md for which service (web / worker) needs what.

# --- Database -------------------------------------------------------------
# Set BOTH to use Supabase (required in production so web + worker share
# state). Leave unset for local SQLite (data/medications.db) — dev only.
SUPABASE_URL=
SUPABASE_KEY=

# --- OTP hashing (web) ----------------------------------------------------
# Strong random secret keying the phone-OTP HMAC. Set in production;
# a random per-process secret is used if unset (pending OTPs drop on restart).
MEDSYNC_OTP_SECRET=

# --- Twilio SMS (web sends OTP, worker sends reminders) -------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Reminder engine ------------------------------------------------------
# IANA timezone all dose times are interpreted in (single-timezone MVP).
APP_TIMEZONE=America/New_York

# --- App URL (web) --------------------------------------------------------
# Public base URL used to build emailed verification / password-reset links.
# Defaults to http://localhost:8501 for local dev; set to the deployed domain
# (e.g. https://app.example.com) in production or those links break.
APP_BASE_URL=

# --- Email (optional: weekly reports, verification/reset) -----------------
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- Dev only -------------------------------------------------------------
# Expose the OTP in the UI when SMS isn't configured. NEVER set in production.
MEDSYNC_DEV_SHOW_OTP=
